NEXT_PUBLIC_SITE_URL=https://sonbolabs.exceptionalgrp.com
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_BOOKING_URL=

# Hostinger SMTP — server-side only
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Shared contact-form rate limit (Upstash Redis). Required in production.
# Before setting CONTACT_RATE_LIMIT_TRUSTED_PROXY=cloudflare, lock the Hostinger
# origin down to Cloudflare IP ranges so CF-Connecting-IP cannot be spoofed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_TRUSTED_PROXY=cloudflare
