{
  "name": "sonbol-contact-origin-proxy",
  "main": "workers/contact-origin-proxy.ts",
  "compatibility_date": "2026-10-21",
  "routes": [
    {
      "pattern": "https://sonbolabs.exceptionalgrp.com/api/contact",
      "zone_name": "exceptionalgrp.com"
    }
  ],
  "secrets": {
    "required": [
      "CONTACT_ORIGIN_HMAC_CURRENT",
      "CONTACT_ORIGIN_HMAC_CURRENT_KEY_ID"
    ]
  }
}
